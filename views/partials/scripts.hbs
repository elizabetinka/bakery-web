    <script src="/js/pasty_details_handler.js" defer></script>
  {{/if}}
  {{#if (eq this 'photo_item_loader')}}
    <script src="/js/details_handler.js" defer></script>
    <script src="/js/photo_details_handler.js" defer></script>
  {{/if}}

  {{#if (eq this 'add_handler')}}
    <script src="/js/add_handler.js" defer></script>
  {{/if}}

  {{#if (eq this 'edit_handler')}}
    <script src="/js/edit_handler.js" defer></script>
  {{/if}}

  {{#if (eq this 'constructor_loader')}}
    <script src="/js/constructor.js" defer></script>
  {{/if}}


{{/each}}