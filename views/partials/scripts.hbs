<script src="/js/loadStats.js" defer></script>
<script src="/js/active.js" defer></script>
<script src="/js/finder.js"></script>
<script src="/js/event_handler.js" defer></script>

{{#each scripts}}
  {{#if (eq this 'cakes_loader')}}
    <script src="/js/pagination.js"></script>
    <script src="/js/cakes_handler.js"></script>
  {{/if}}
  {{#if (eq this 'pasty_loader')}}
    <script src="/js/pagination.js" defer></script>
    <script src="/js/pasty_handler.js" defer></script>
  {{/if}}
  {{#if (eq this 'photo_loader')}}
    <script src="/js/pagination.js" defer></script>
    <script src="/js/photo_handler.js" defer></script>
  {{/if}}
  {{#if (eq this 'cake_item_loader')}}
    <script src="/js/details_handler.js" defer></script>
    <script src="/js/cake_details_handler.js" defer></script>
  {{/if}}
  {{#if (eq this 'pastry_item_loader')}}
