<div class="preloader" id="preloader">
  <p>Загрузка...</p>
</div>

<div id="error-message" class="error-message"></div>

<section class="about kurale-regular">

  <div class="about_map">
    <img src={{photo.image}} alt={{photoe.name}} class="catalog_card_photo_img">
  </div>

  <div class="item-details" data-id={{photo.id}}>
    <h1>Название</h1>
    <div class="about_text_paragraph">
      <p>{{photo.name}}</p>
    </div>

    <div class="about_bottom">
      <div class="about_text_paragraph">
        <p>Сладкие моменты — особенные моменты!</p>
      </div>
      <div class="about_bottom_buttons">
      <button class="edit-btn">Изменить</button>
      <button class="delete-btn">Удалить</button>
    </div>
    </div>
  </div>

</section>

<div class="description description_position">
  <blockquote class="description_blockquote great-vibes-regular"><b>Формула вашего счастья:</b> мука + крем <sup>2</sup> + начинка <sup>3</sup></blockquote>
</div>